    # Define once in nginx's http {} scope, outside server/location blocks.
    # Sensitive route logs retain operational status without path/query,
    # Referer or User-Agent (all can contain a subscription bearer):
    # log_format mgboost_sensitive '$remote_addr [$time_local] '
    #     '"$request_method <redacted-sensitive-target> $server_protocol" '
    #     '$status $body_bytes_sent';
    #
    # limit_req_zone $binary_remote_addr zone=marzban_admin_login:10m rate=5r/m;
    #
    # Any public server that proxies Marzban must override its generic `/`
    # location with this exact login route.  MGBoost's own admin login has an
    # additional failed-attempt limiter in the application.
    # location = /api/admin/token {
    #     limit_req zone=marzban_admin_login burst=5 nodelay;
    #     limit_req_status 429;
    #     proxy_pass http://127.0.0.1:8000;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto https;
    # }

    location /lk/ {
        access_log /var/log/nginx/mgboost-sensitive-access.log mgboost_sensitive;
        proxy_pass http://127.0.0.1:8001/lk/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /sub/ {
        access_log /var/log/nginx/mgboost-sensitive-access.log mgboost_sensitive;
        if ($http_user_agent ~* "(Mozilla|Chrome|Safari|Firefox|Edge|Opera)") {
            return 302 /sub-browser;
        }
        proxy_pass http://127.0.0.1:8001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /sub-admin/ {
        proxy_pass http://127.0.0.1:8001/sub-admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /sub-admin-api/ {
        proxy_pass http://127.0.0.1:8001/admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

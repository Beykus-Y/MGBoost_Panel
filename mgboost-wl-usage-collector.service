[Unit]
Description=MGBoost WL usage ledger collector cycle (PH6-03 runtime, PH6-09 chain)
Wants=network-online.target mgboost-marzban-broker.service
After=network-online.target local-fs.target mgboost-panel.service mgboost-marzban-broker.service
Documentation=file:/opt/MGBoost_Panel/docs/PHASE6_09_WL_FAIL_SAFE.md

[Service]
Type=oneshot
User=mgboost
Group=mgboost
UMask=0077
WorkingDirectory=/opt/MGBoost_Panel
ExecStart=/opt/mgboost-venvs/ph1-07/bin/python /opt/MGBoost_Panel/scripts/run_wl_usage_collector.py --db /opt/MGBoost_Panel/data/db.sqlite3
EnvironmentFile=/opt/MGBoost_Panel/.env
Environment=PYTHONPATH=/opt/MGBoost_Panel
Environment=PYTHONDONTWRITEBYTECODE=1
# One bounded observe-only collection pass; the PH6-03 single-leader CAS
# lease makes overlapping invocations safe by construction (losers no-op).
TimeoutStartSec=900
# Clean exit codes: 0 = cycle finished (any recorded outcome), no secrets in
# argv, journald gets only the aggregate identifier-free JSON summary.
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/MGBoost_Panel/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target

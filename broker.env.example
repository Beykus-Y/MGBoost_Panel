# This file belongs only to mgboost-marzban-broker.service.
# Install it as /etc/mgboost/marzban-broker.env with 0640 root:mgboost-broker.
MARZBAN_URL=http://127.0.0.1:8000
MARZBAN_ADMIN_USER=dedicated_mgboost_service_admin
MARZBAN_ADMIN_PASS=

# Generate independently with a CSPRNG (at least 32 random bytes). The same
# value is supplied to the MGBoost main service as MARZBAN_BROKER_AUTH_KEY.
MARZBAN_BROKER_AUTH_KEY=
MARZBAN_BROKER_CLIENT_ID=mgboost-main
MARZBAN_BROKER_ALLOWED_SKEW_SECONDS=30
MARZBAN_BROKER_LISTEN_HOST=127.0.0.1
MARZBAN_BROKER_LISTEN_PORT=8002
MARZBAN_BROKER_MAX_WORKERS=16

# PH3-03 dual-run SHADOW resolver capability boundary. Leaving this unset
# keeps the broker in single-policy legacy mode (identical to pre-PH3-03
# behavior). Setting it splits authorization into two separate HMAC
# identities: mgboost-main (MARZBAN_BROKER_AUTH_KEY, above) loses
# child.user.credentials.get, and only mgboost-sub-resolver
# (this key) may call it. Generate independently; the same value is supplied
# to the MGBoost main service as MARZBAN_BROKER_RESOLVER_AUTH_KEY.
MARZBAN_BROKER_RESOLVER_AUTH_KEY=

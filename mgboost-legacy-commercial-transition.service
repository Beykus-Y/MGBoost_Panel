[Unit]
Description=MGBoost legacy to commercial transition worker
Wants=network-online.target mgboost-marzban-broker.service
After=network-online.target mgboost-marzban-broker.service

[Service]
Type=oneshot
User=mgboost
Group=mgboost
UMask=0077
WorkingDirectory=/opt/MGBoost_Panel
ExecStart=/opt/mgboost-venvs/ph1-07/bin/python /opt/MGBoost_Panel/scripts/run_legacy_commercial_transition_worker.py --db /opt/MGBoost_Panel/data/db.sqlite3
EnvironmentFile=/opt/MGBoost_Panel/.env
Environment=PYTHONPATH=/opt/MGBoost_Panel
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=MGBOOST_SKIP_DOTENV=1
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/MGBoost_Panel/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
SystemCallArchitectures=native

MARZBAN_URL=http://127.0.0.1:8000
MARZBAN_SERVICE_MODE=broker
MARZBAN_BROKER_URL=http://127.0.0.1:8002
MARZBAN_BROKER_AUTH_KEY=
MARZBAN_BROKER_CLIENT_ID=mgboost-main
MARZBAN_BROKER_TIMEOUT_SECONDS=10
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8001
DATA_DIR=./data
SECRET_KEY=changeme
INTERNAL_API_KEY=change_me_for_adminvps_link
INTERNAL_API_ALLOWED_SKEW_SECONDS=300
# Keep disabled until every external Filin mutation caller sends signed v2
# requests with a stable X-Filin-Idempotency-Key.
INTERNAL_API_REQUIRE_V2_MUTATIONS=0
INTERNAL_API_IDEMPOTENCY_TTL_SECONDS=604800
# PH2-04 rollout: deploy/report-only first, then set to 1 after the browser
# subscription page passes its production asset/console gate.
SUB_BROWSER_CSP_ENFORCE=0
# Admin UI uses an opaque server-side session. Keep Secure enabled in production.
ADMIN_SESSION_TTL_SECONDS=1800
ADMIN_SESSION_COOKIE_SECURE=1
ADMIN_LOGIN_RATE_WINDOW_SECONDS=300
ADMIN_LOGIN_RATE_IDENTITY_FAILURES=5
ADMIN_LOGIN_RATE_IP_FAILURES=20
# MARZBAN_ADMIN_USER/PASS intentionally do not belong in the main process.
# They exist only in /etc/mgboost/marzban-broker.env.
# Required for the bot's "Manage devices" deep-link feature: public hostname
# used to build /lk/ links sent via Telegram (device management deep links).
# No trailing slash/scheme. If unset, that feature fails closed with a
# clear error instead of sending a broken or wrong-domain link.
PUBLIC_HOST=
